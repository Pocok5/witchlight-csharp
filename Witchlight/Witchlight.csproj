<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Witchlight</AssemblyName>
    <RootNamespace>Witchlight</RootNamespace>
    <!-- The mod is loaded by the game, which supplies these assemblies. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Writes Witchlight.xml beside the DLL. A plugin references this assembly
         at compile time, and this is what puts the documentation on every method
         it calls into that plugin author's editor. See docs/PLUGINS.md in the
         map service repository. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The mod is not a library and its doc comments are written for people
         reading the source, not as a documentation build. Turning the file on
         makes the compiler start checking them, which reports a hundred missing
         param tags and unresolved crefs in code no plugin ever calls and buries
         anything real. The comments on the plugin API itself are complete and
         are what a plugin author's editor shows. -->
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1574;CS1570;CS1572;CS0419</NoWarn>

    <!-- Where the game is installed. Override with -p:VintageStory=/path or the
         VINTAGE_STORY environment variable the official mod template uses. -->
    <VintageStory Condition="'$(VintageStory)' == ''">$(VINTAGE_STORY)</VintageStory>
    <VintageStory Condition="'$(VintageStory)' == ''">$(HOME)/.local/share/vintagestory</VintageStory>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStory)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStory)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VintageStory)/Mods/VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintageStory)/Mods/VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintageStory)/Lib/protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The drawing library the game's own GUI is composed with: a row shaded
         in a table is a rectangle drawn into the window's surface, and the
         delegate that draws it is handed this library's context. -->
    <Reference Include="cairo-sharp">
      <HintPath>$(VintageStory)/Lib/cairo-sharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The one library the mod API has no substitute for: reading a rendered
         picture back off the graphics card. Client only, which is why every use
         of it stays inside a method body a server never calls. -->
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VintageStory)/Lib/OpenTK.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>$(VintageStory)/Lib/SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStory)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The base game's block colours, recorded once so that a dedicated server
         — whose install ships almost no block textures — draws a coloured map
         from the moment it starts rather than waiting for a client to send one.
         Refreshed by bake-palette.py; read by Palette/Vanilla.cs. -->
    <EmbeddedResource Include="Palette/vanilla.json.gz" />
  </ItemGroup>

</Project>
